# 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장하고, 아래 값을 채우세요.
# (config/.env 는 git 에 올라가지 않습니다)

# Google AI Studio 에서 무료로 발급: https://aistudio.google.com/apikey
#  - 구글 계정만 있으면 됨, 유료 결제 필요 없음
LLM_PROVIDER=gemini
GEMINI_API_KEY=여기에_발급받은_키_붙여넣기
GEMINI_MODEL=gemini-3.5-flash

# 소스(사이트) 하나당 최대 몇 개의 글을 확인할지
MAX_POSTS_PER_SOURCE=12

# 자바스크립트로만 내용이 뜨는 사이트에 Playwright(자동 브라우저) 사용
#  1 = 사용(권장), 0 = 끔
USE_PLAYWRIGHT_FALLBACK=1
