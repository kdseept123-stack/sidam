{
  "expo": {
    "name": "시담",
    "slug": "sidam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sidam",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sidam.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B6B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sidam.app"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B6B",
          "sounds": [],
          "androidMode": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e58413db-f1ca-43d4-9328-50c57f62d525"
      }
    },
    "owner": "hyeeun0301",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e58413db-f1ca-43d4-9328-50c57f62d525"
    }
  }
}
